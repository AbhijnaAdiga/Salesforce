<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DateofBirth_must_be_lesser_than_today</fullName>
    <active>true</active>
    <description>DateofBirth_must_be_lesser_than_today</description>
    <errorConditionFormula>OR ( DateOfBirth__c &gt; TODAY() ,

( ( TODAY() - DateOfBirth__c ) / 365 ) &lt; 15

)</errorConditionFormula>
    <errorDisplayField>DateOfBirth__c</errorDisplayField>
    <errorMessage>Date of Birth Must be in Past!!!</errorMessage>
</ValidationRule>
